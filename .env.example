# Copier ce fichier en .env puis remplir. Ne jamais publier .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generer-une-cle-longue-et-aleatoire
ALLOWED_HOSTS=metallink.cm,www.metallink.cm

# Base MySQL
DB_ENGINE=mysql
DB_NAME=metallink
DB_USER=metallink_user
DB_PASSWORD=mot-de-passe-fort
DB_HOST=127.0.0.1
DB_PORT=3306

# Espace administrateur : adresse secrete + seul compte autorise
ADMIN_PATH=pilotage-x7k29q
OWNER_EMAIL=vous@exemple.com
# Optionnel : liste d'IP autorisees (separees par des virgules). Vide = pas de restriction IP.
ADMIN_ALLOWED_IPS=
TRUST_PROXY=1

# Notifications vers l'administrateur
ADMIN_NOTIFY_EMAIL=vous@exemple.com
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MetalLink <no-reply@metallink.cm>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Service client affiche sur le site
SUPPORT_WHATSAPP=2376XXXXXXXX
SUPPORT_EMAIL=contact@metallink.cm

# Paiement mobile (agregateur MTN MoMo / Orange Money)
PAY_PROVIDER=campay
PAY_BASE_URL=https://www.campay.net/api
PAY_USER=
PAY_PASSWORD=
PAY_WEBHOOK_KEY=

# 1 = CSS Tailwind compile (recommande en production, voir MANUEL.md)
USE_COMPILED_CSS=0

# Code de verification Google Search Console (voir MANUEL.md, partie referencement)
GOOGLE_SITE_VERIFICATION=
